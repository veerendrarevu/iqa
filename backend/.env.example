# Copy this file to .env and fill in your Neon connection string.
# Never commit the real .env to version control.

# Neon serverless Postgres — get this from your Neon project dashboard.
# Use the "psycopg2" / "direct" connection string (not the pooled one for pgBouncer).
DATABASE_URL=postgresql://neondb_owner:YOURPASSWORD@ep-xxx-yyy-zzz.region.aws.neon.tech/neondb?sslmode=require

# Optional settings (shown with their defaults)
# MAX_UPLOAD_MB=10
# CORS_ORIGINS=http://localhost:5173

